{
  "name": "wa-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Читает ваши чаты WhatsApp как связанное устройство, делает summary через LLM и присылает дайджесты в Telegram",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run build -- --mode production"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "6.7.24",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "grammy": "^1.46.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "openai": "^7.15.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
