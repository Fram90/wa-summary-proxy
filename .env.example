# --- Веб-панель ---
HOST=0.0.0.0
PORT=43117
# Обязательно задайте, если панель доступна из интернета. Минимум 8 символов.
DASHBOARD_TOKEN=
# Куда писать базу и ключи сессии WhatsApp. В Docker переопределяется на /app/data.
DATA_DIR=./data
LOG_LEVEL=info

# --- Модель для summary ---
# Подойдёт любой OpenAI-совместимый провайдер.
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   Ollama:      http://host.docker.internal:11434/v1  (ключ любой непустой)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Бюджет символов на один запрос; более длинная переписка режется на части.
LLM_CHUNK_CHARS=40000
LLM_TIMEOUT_MS=180000

# --- Telegram ---
# Токен получите у @BotFather.
TELEGRAM_BOT_TOKEN=
# Можно оставить пустым: первый, кто напишет боту /start, станет владельцем.
TELEGRAM_CHAT_ID=

# --- Дайджесты ---
# Стандартный cron: минуты часы день месяц день_недели. По умолчанию 9:00 и 21:00.
DIGEST_CRON=0 9,21 * * *
DIGEST_TZ=Europe/Moscow
# Сколько часов переписки попадает в плановый дайджест.
DIGEST_WINDOW_HOURS=12
# Через сколько дней удалять сохранённые сообщения.
RETENTION_DAYS=30

# --- WhatsApp ---
# Просить максимум истории при первичной привязке устройства.
WA_SYNC_FULL_HISTORY=true

# Демо-режим: WhatsApp не подключается, панель работает на примерах.
DEMO_MODE=false
